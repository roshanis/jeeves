# Copy to .env in this directory and fill in. `.env` is gitignored.
#
#   cp env.example .env

# --- required ---------------------------------------------------------
# Postgres credentials. The database is NOT published to the host — only the
# app container can reach it — but pick a real password anyway: `podman
# compose` writes this into the container environment, and a weak one is a
# weak one the moment the network topology changes.
POSTGRES_PASSWORD=change-me

# Gates the live/mutable demo workspace. Public visitors stay read-only
# without it. Treat it as a credential even though it is meant to be typed in
# front of an audience.
DEMO_PASSCODE=change-me-too

# --- optional ---------------------------------------------------------
POSTGRES_DB=jeeves
POSTGRES_USER=jeeves

# Host port for the app. The container always listens on 3000 internally.
APP_PORT=3000

# Leave OPENAI_API_KEY UNSET unless you specifically want live LLM drafting.
# With no key the app runs on the deterministic keyless mock adapter and
# cannot generate any spend — the right default for anything reachable.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1

# Bearer token for GET /api/cron/monitor. Unset means the cron endpoint
# returns 503; the manual admin action still works.
# CRON_SECRET=
