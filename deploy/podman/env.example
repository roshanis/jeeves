# Copy to .env in this directory and fill in. `.env` is gitignored.
#
#   cp env.example .env

# --- required ---------------------------------------------------------
# Postgres credentials. The database is NOT published to the host — only the
# app container can reach it — but pick a real password anyway: `podman
# compose` writes this into the container environment, and a weak one is a
# weak one the moment the network topology changes.
POSTGRES_PASSWORD=change-me

# Deprecated: there is no passcode gate any more. It is only the fallback seed
# for the cookie signing key when JEEVES_COOKIE_SECRET is blank (demo only).
# compose.yaml still requires it to be set. Treat it as a credential.
DEMO_PASSCODE=change-me-too

# Runs this stack as the public demo. Leave it as is: an unset or any other
# value means PRODUCTION mode, which refuses to boot without APP_BASE_URL,
# JEEVES_TENANT_ID and a 32+ character cookie secret, and has no demo personas.
JEEVES_MODE=demo

# --- Quadlet only -----------------------------------------------------
# The Quadlet app unit reads this file as its whole environment and cannot
# assemble the URL the way compose.yaml does. Use the same password as
# POSTGRES_PASSWORD above. Compose ignores this line (it builds its own).
# Also set JEEVES_COOKIE_SECRET below (`openssl rand -hex 32`).
DATABASE_URL=postgres://jeeves:change-me@jeeves-db:5432/jeeves

# --- optional ---------------------------------------------------------
# Server-only key that signs browser workspace cookies. Generate with
# `openssl rand -hex 32`. If blank, a key derived from DEMO_PASSCODE is used
# (deprecated; the demo only).
# JEEVES_COOKIE_SECRET=

POSTGRES_DB=jeeves
POSTGRES_USER=jeeves

# Host port for the app. The container always listens on 3000 internally.
APP_PORT=3000

# Leave OPENAI_API_KEY UNSET unless you specifically want live LLM drafting.
# With no key the app runs on the deterministic keyless mock adapter and
# cannot generate any spend — the right default for anything reachable.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1

# Bearer token for GET /api/cron/monitor. Unset means the cron endpoint
# returns 503; the manual admin action still works.
# CRON_SECRET=
