# Copy to .env in this directory and fill in. `.env` is gitignored.
#
#   cp env.example .env
#
# Every variable the app reads: docs/environment-reference.md

# --- required ---------------------------------------------------------
# Postgres credentials. The database is NOT published to the host — only the
# app container can reach it — but pick a real password anyway: `podman
# compose` writes these into the container environment, and a weak one is a
# weak one the moment the network topology changes.
#
# Three roles, three different passwords:
#   POSTGRES_PASSWORD      the bootstrap superuser. Used only to initialise the
#                          database and by `compose run --rm grants`.
#   JEEVES_OWNER_PASSWORD  jeeves_owner owns the schema; migrations and the seed.
#   JEEVES_APP_PASSWORD    jeeves_app owns nothing; the app's role. A role that
#                          owns audit_events could switch its triggers off.
# Quadlet: put these three in jeeves-db.env (the database unit reads it), not in
# jeeves.env, which the app unit also reads.
POSTGRES_PASSWORD=change-me
JEEVES_OWNER_PASSWORD=change-me-too
JEEVES_APP_PASSWORD=change-me-as-well

# Server-only key that signs the browser workspace cookie. Visitors never
# enter it, but anyone who learns it can forge a cookie and join another
# visitor's workspace, so make it random: openssl rand -hex 32
JEEVES_COOKIE_SECRET=

# Runs this stack as the public demo. Leave it as is: an unset or any other
# value means PRODUCTION mode, which refuses to boot without APP_BASE_URL,
# JEEVES_TENANT_ID and a 32+ character cookie secret, and has no demo personas.
JEEVES_MODE=demo

# --- Quadlet only -----------------------------------------------------
# The Quadlet app unit reads this file as its whole environment and cannot
# assemble the URL the way compose.yaml does. Use the jeeves_app role and the
# same password as JEEVES_APP_PASSWORD above. Compose ignores this line (it
# builds its own).
DATABASE_URL=postgres://jeeves_app:change-me-as-well@jeeves-db:5432/jeeves
# Production mode refuses a database on another host without verified TLS.
# jeeves-db is this stack's own container, reached without TLS on this host's
# private network, so the stack opts out. Demo mode ignores it. Delete this
# line if DATABASE_URL ever points at another machine. Compose sets its own.
JEEVES_DB_ALLOW_UNVERIFIED=same-host

# --- optional ---------------------------------------------------------
# How many reverse proxies in front of the app append to X-Forwarded-For (rate
# limits key on the client address that implies). compose.yaml defaults to
# `none`, which ignores the header and puts every caller in one rate-limit
# bucket: right while the app port is published directly with no proxy. Put a
# proxy in front, then set 1 (an AWS ALB or an appending nginx). 0 only for a
# platform that overwrites the header (Vercel). Quadlet: change the
# Environment= line in jeeves-app.container.
# JEEVES_TRUSTED_PROXY_HOPS=none

POSTGRES_DB=jeeves
POSTGRES_USER=jeeves

# Host port for the app. The container always listens on 3000 internally.
APP_PORT=3000

# Leave OPENAI_API_KEY UNSET unless you specifically want live LLM drafting.
# With no key the app runs on the deterministic keyless mock adapter and
# cannot generate any spend — the right default for anything reachable.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1

# Bearer token for GET /api/cron/monitor. Unset means the cron endpoint
# returns 503; the manual admin action still works.
# CRON_SECRET=

# Opens the "Send a real request" door and the /operator queue that reads it.
# At least 32 characters (openssl rand -hex 32). While it is unset or shorter
# the door stays closed, because nobody could read what a visitor sent.
# OPERATOR_TOKEN=
