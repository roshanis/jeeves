# Postgres data. Podman manages the volume; back it up with
# `podman volume export jeeves-pgdata` (see docs/deploy-podman.md).
# Upgrading a Quadlet install created before this name: its data is in the volume
# `jeeves-db`; export it and import it into `jeeves-pgdata` before starting.
[Unit]
Description=Jeeves Postgres data volume

[Volume]
VolumeName=jeeves-pgdata
