# Jeeves app, managed by systemd via Podman Quadlet.
#
# Build BOTH images first (Quadlet does not build):
#   podman build -f deploy/podman/Containerfile -t localhost/jeeves:latest .
#   podman build -f deploy/podman/Containerfile --target migrator \
#     -t localhost/jeeves-migrator:latest .
#
# Then apply migrations once, before first start. Note this uses the MIGRATOR
# image: the runtime image is the traced standalone output and deliberately
# does not carry tsx/esbuild.
#   podman run --rm --network jeeves \
#     -e DATABASE_URL='postgres://jeeves:PASSWORD@jeeves-db:5432/jeeves' \
#     localhost/jeeves-migrator:latest npm run db:migrate
[Unit]
Description=Jeeves AI Governance Gateway
After=network-online.target
# Start ordering only — systemd cannot wait on the DB's health from here, so
# the app may briefly fail its own health check while Postgres finishes
# starting. Restart=always below covers that; the health probe is what keeps
# a database-less instance from being treated as up.
Requires=jeeves-db.service
After=jeeves-db.service

[Container]
ContainerName=jeeves-app
Image=localhost/jeeves:latest
Network=jeeves.network
PublishPort=3000:3000

# jeeves.env (a copy of deploy/podman/env.example, "Quadlet only" section) must
# define DATABASE_URL and JEEVES_COOKIE_SECRET (`openssl rand -hex 32`), the
# key that signs browser workspace cookies. Without it the cookie can be
# neither signed nor trusted, so a visitor whose session has ended comes back
# to a new, empty workspace.
# It also carries JEEVES_DB_ALLOW_UNVERIFIED=same-host, which production mode
# needs to reach the jeeves-db container without TLS on this host's private
# network (demo mode ignores it). Delete that line from jeeves.env if
# DATABASE_URL ever points at another machine: that one needs verified TLS.
EnvironmentFile=%h/.config/containers/systemd/jeeves.env
Environment=DATA_PROVIDER=db
Environment=NODE_ENV=production
# This unit runs the demo. An unset JEEVES_MODE means production, which refuses
# to boot without APP_BASE_URL, JEEVES_TENANT_ID and a cookie secret.
Environment=JEEVES_MODE=demo
# Proxies in front of the app that append to X-Forwarded-For. `none` means
# nothing in front appends to or overwrites the header. This unit publishes the
# port directly with no proxy, so a caller-sent header is forged: `none`
# ignores it and all callers share one rate-limit bucket. Behind a proxy that
# appends the client address, change it to 1 (an AWS ALB or nginx) and stop
# publishing the port to the network.
Environment=JEEVES_TRUSTED_PROXY_HOPS=none

# GET /api/health/live answers from the process alone, so a short database
# outage does not get the container restarted. GET /api/health is the
# database-aware readiness check, for a load balancer in front.
HealthCmd=node -e "fetch('http://127.0.0.1:3000/api/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=15s

# Defence in depth — the app writes nothing to its own filesystem. Next needs
# a writable /tmp for its cache, so that is mounted as tmpfs rather than
# leaving the whole root writable.
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=64m
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
