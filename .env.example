# Jeeves — environment template. Copy to .env.local and fill in real values.
# Never commit real secrets; .env* is gitignored (except this example file).

# Neon Postgres connection string (plan.md §4) — used by Drizzle.
DATABASE_URL=postgres://user:password@example-host.neon.tech/jeeves?sslmode=require

# OpenAI runtime LLM (plan.md §1). All LLM calls are mocked in tests.
# With OPENAI_API_KEY unset, the app runs entirely on the deterministic
# offline mock adapter — the honest default for a public demo.
OPENAI_API_KEY=sk-placeholder-not-a-real-key
OPENAI_MODEL=gpt-5.1

# Which real AgentPort implementation to use when OPENAI_API_KEY is set:
#   ai-sdk     (default) Vercel AI SDK — one structured call per invocation.
#   agents-sdk           OpenAI Agents SDK — same port, per-method model
#                        routing, and the opt-in deep-review tool loop below.
# Unset/unrecognised behaves as ai-sdk. Neither value affects the mock
# fallback: no API key still means the mock adapter, unchanged.
JEEVES_AGENT_RUNTIME=ai-sdk

# Per-method model routing for the agents-sdk runtime. Luna handles the
# high-volume, latency-sensitive calls (completeness, intake turns, triage
# narration, grounded audit answers); Terra handles nuanced policy-grounded
# review drafting, where quality matters more than time-to-first-token.
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_TERRA_MODEL=gpt-5.6-terra

# Reasoning effort for the agents-sdk runtime. Kept low by default for demo
# latency — Luna at max effort has a very high time-to-first-token.
# One of: minimal | low | medium | high.
OPENAI_REASONING_EFFORT=low

# Opt-in deep review (agents-sdk runtime only): draftReview becomes a
# tool-using loop that reads the policy corpus (read-only, sandboxed to
# docs/policies/ and agents/reviewer/) before drafting. Costs many model
# calls per domain, so the draft-run route reserves a 10x budget multiplier
# when this is on. Unset or any value other than "1" leaves the standard
# single-call path in place.
JEEVES_DEEP_REVIEW=

# Passcode gating the live/mutable demo workspace (plan.md §3).
DEMO_PASSCODE=changeme-demo-passcode
