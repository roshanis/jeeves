# Jeeves — environment template. Copy to .env.local and fill in real values.
# Never commit real secrets; .env* is gitignored (except this example file).

# Deployment mode. DEFAULTS TO PRODUCTION: demo is an explicit opt-in, so any
# value other than exactly "demo" (unset, empty, "Demo", "prod") is production.
# Production mode refuses to start unless the production settings below are
# complete, and it has no demo personas, no playground and no public intake.
# Local development, tests and CI are the demo, so this is set here. Never
# NEXT_PUBLIC_: the mode is server-only.
JEEVES_MODE=demo

# Production mode only (JEEVES_MODE unset or anything but "demo"). All are
# required there; the app exits at boot, listing what is missing, if not.
#   DATABASE_URL or POSTGRES_URL  a real Postgres server; never the local PGlite
#   JEEVES_COOKIE_SECRET          32+ characters; DEMO_PASSCODE is not a fallback
#   APP_BASE_URL                  absolute https URL, e.g. https://jeeves.example.com
#   JEEVES_TENANT_ID              identifier of the organisation this install serves
#   DATA_PROVIDER                 leave unset or "db"; "mock" is refused
# APP_BASE_URL=
# JEEVES_TENANT_ID=

# PostgreSQL runtime URL, used by Drizzle. Takes precedence over POSTGRES_URL.
# Vercel's Supabase integration supplies POSTGRES_URL automatically; leave
# DATABASE_URL blank in that case. Vercel cannot use local PGlite storage.
DATABASE_URL=
# Example: postgres://user:password@example-host.neon.tech/jeeves?sslmode=require
# POSTGRES_URL=
# DATABASE_MIGRATION_URL=  # Direct/session connection for migrations, never port 6543.
# DATABASE_SSL_CA=        # Optional CA (PEM). Any PostgreSQL host except Neon: connect with TLS and verify
#                         # the server against it (for Amazon RDS, the RDS CA bundle).
# Production mode refuses a database on another host unless the connection is
# TLS with certificate verification: sslmode=verify-full in the URL, or
# DATABASE_SSL_CA. Loopback hosts are exempt. The only opt-out is
# JEEVES_DB_ALLOW_UNVERIFIED=same-host, for a database container on this host's
# private network (the Podman stacks); any other value fails boot. Demo mode
# checks none of this. Details: docs/environment-reference.md.
# JEEVES_DB_ALLOW_UNVERIFIED=

# OpenAI runtime LLM (plan.md §1). All LLM calls are mocked in tests.
# With OPENAI_API_KEY unset, the app runs entirely on the deterministic
# offline mock adapter — the honest default for a public demo. ANY non-empty
# value (a placeholder included) switches the app to the live OpenAI adapter,
# so leave the line commented out until you have a real key.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Which real AgentPort implementation to use when OPENAI_API_KEY is set:
#   ai-sdk     (default) Vercel AI SDK — one structured call per invocation.
#   agents-sdk           OpenAI Agents SDK — same port, per-method model
#                        routing, and the opt-in deep-review tool loop below.
# Unset/unrecognised behaves as ai-sdk. Neither value affects the mock
# fallback: no API key still means the mock adapter, unchanged.
JEEVES_AGENT_RUNTIME=ai-sdk

# Per-method model routing for the agents-sdk runtime. Luna handles the
# high-volume, latency-sensitive calls (intake turns and grounded audit
# answers; completeness checks and triage are deterministic code, not model
# calls); Terra handles nuanced policy-grounded review drafting, where quality
# matters more than time-to-first-token.
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_TERRA_MODEL=gpt-5.6-terra

# Reasoning effort for the agents-sdk runtime. Kept low by default for demo
# latency — Luna at max effort has a very high time-to-first-token.
# One of: minimal | low | medium | high.
OPENAI_REASONING_EFFORT=low

# Opt-in deep review (agents-sdk runtime only): draftReview becomes a
# tool-using loop that reads the policy corpus (read-only, sandboxed to
# docs/policies/ and agents/reviewer/) before drafting. Costs many model
# calls per domain, so the draft-run route reserves a 10x budget multiplier
# when this is on. Unset or any value other than "1" leaves the standard
# single-call path in place.
JEEVES_DEEP_REVIEW=

# Server-only random key signing browser workspaces; visitors enter without a password.
# Generate with: openssl rand -hex 32
JEEVES_COOKIE_SECRET=

# Server-only secret that opens /operator — the queue of REAL requests sent
# through "Send a real request" on the intake page. Deliberately not tied to
# any demo persona: the passwordless playground gives every persona, Program
# Office and Admin included, to every visitor. Unset (or shorter than 32
# characters) switches the queue off entirely; /api/public-intake returns 404.
# Generate with: openssl rand -hex 32
OPERATOR_TOKEN=

# ---------------------------------------------------------------------------
# Everything below is optional and commented out. Each is read by the code;
# docs/environment-reference.md lists the defaults and the files that read it.
# ---------------------------------------------------------------------------

# Number of reverse proxies in front of the app that append to X-Forwarded-For
# ("none" or a whole number). Rate limits key on the client address it selects.
# Required in production mode; set it to match your proxy chain.
# JEEVES_TRUSTED_PROXY_HOPS=

# Bearer token for GET /api/cron/monitor (demo mode only). Unset answers 503.
# CRON_SECRET=

# Compile the demo out of a build: 0 makes JEEVES_MODE=demo ineffective.
# JEEVES_DEMO_ENABLED=

# Force the database driver: neon or pg. By default *.neon.tech uses Neon's.
# JEEVES_DB_DRIVER=
# Directory of the local PGlite store when no database URL is set.
# JEEVES_PGLITE_DIR=
# Connection pool size, and server-side timeouts in milliseconds (0 turns off).
# DATABASE_POOL_MAX=
# DATABASE_STATEMENT_TIMEOUT_MS=
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=
# DATABASE_MIGRATION_LOCK_TIMEOUT_MS=
# TLS posture read by node-postgres and the production boot check. Never set
# NODE_TLS_REJECT_UNAUTHORIZED=0 for a database on another host.
# PGSSLMODE=
# PGSSLNEGOTIATION=
# NODE_TLS_REJECT_UNAUTHORIZED=

# Evidence storage ceilings in whole MiB ("none" lifts one): per workspace, and
# for the whole database (demo only).
# JEEVES_EVIDENCE_WORKSPACE_MAX_MIB=
# JEEVES_EVIDENCE_TOTAL_MAX_MIB=

# Agents SDK tracing: 1 turns it on.
# JEEVES_AGENT_TRACING=

# Telemetry connector shown as configured on the monitoring page. The data
# stays synthetic ("Synthetic data — demo").
# PHOENIX_ENDPOINT=
# PHOENIX_PROVIDER_NAME=

# Destructive seed and reset scripts (demo databases only, never a shared one).
# ALLOW_SEED=1 lets them run with NODE_ENV=production.
# ALLOW_DISCARD_PUBLIC_REQUESTS=<count> must equal the number of real requests
# to be discarded, or the run is refused.
# ALLOW_SEED=
# ALLOW_DISCARD_PUBLIC_REQUESTS=

# Public site, read at build time (visible in the browser bundle, so never put
# a secret here): origin for the sitemap, contact and privacy links, pilot price.
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_CONTACT_URL=
# NEXT_PUBLIC_PRIVACY_CONTACT=
# NEXT_PUBLIC_PILOT_PRICE=
